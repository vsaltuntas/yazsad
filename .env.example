# --- Supabase Postgres (eu-central-1 Frankfurt) ---
# Pooler (transaction mode, :6543) — runtime queries
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Direct connection (:5432) — migrations ve seed için
DATABASE_URL_DIRECT=postgres://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase API keys (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase JWT secret — RLS için Clerk JWT template'ini bununla imzalayacaksın
SUPABASE_JWT_SECRET=

# --- Clerk (https://clerk.com — EU residency) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
CLERK_JWT_TEMPLATE=supabase
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/kayit

# --- Cloudflare R2 (ses dosyaları) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yazsad-uploads
R2_PUBLIC_URL=https://media.yazsad.org

# --- iyzico ---
IYZICO_API_KEY=sandbox-xxx
IYZICO_SECRET_KEY=sandbox-xxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Resend ---
RESEND_API_KEY=re_xxx
RESEND_FROM="YAZSAD <bilgi@yazsad.org>"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YAZSAD
KVKK_VERSION=2026-04-01
PLATFORM_COMMISSION_PCT=15

# --- Test (opsiyonel) ---
# RLS smoke testleri için ephemeral DB. Boşsa testler skip olur.
DATABASE_URL_TEST=
